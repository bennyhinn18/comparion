# Environment Variables for Comparion

# Gemini AI API Key (required)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SearXNG Instance URL (optional - defaults to public instance)
# For self-hosted instance, use your own URL
# Public instances: https://searx.be, https://searx.ninja, https://search.privacyguides.net
SEARXNG_URL=https://searx.be

# Database URL (for future use)
# DATABASE_URL=sqlite:./comparion.db

# Next.js Environment
NODE_ENV=development
